{
  "name": "lifesim",
  "version": "0.0.0",
  "private": true,
  "description": "真实历史统计人生模拟（v0.1 开发中，尚不可玩）",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @lifesim/web dev",
    "build": "pnpm --filter @lifesim/web build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @lifesim/web test:e2e",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "notices": "node scripts/check-licenses.mjs --write",
    "verify": "pnpm format:check && pnpm lint && pnpm check:boundaries && pnpm check:licenses && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
